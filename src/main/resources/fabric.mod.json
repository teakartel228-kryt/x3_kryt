{
	"schemaVersion": 1,
	"id": "remake",
	"version": "${version}",
	"name": "•|{[REMAKE]}|•",
	"description": "Arsenal mod: hook, claws, electro wings, springs, conveyors.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/remake/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.example.TemplateMod",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.example.client.TemplateModClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "com.example.client.TemplateModDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"template-mod.mixins.json",
		{
			"config": "template-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}